# --- Telegram ---
BOT_TOKEN=your_telegram_bot_token_here

# --- MikroTik RouterOS (REST API, v7+) ---
MT_HOST=192.168.88.1
MT_USER=admin
MT_PASS=your_router_password
# Публичный IP или домен, который будут видеть клиенты VPN
MT_PUBLIC_IP=vpn.example.com
# Отключить проверку самоподписанного TLS-сертификата (true/false)
MT_VERIFY_TLS=false
# Использовать HTTPS для подключения к RouterOS REST API (true/false)
MT_USE_SSL=false

# --- WireGuard ---
WG_MTU=1420
# DNS для клиентов: 'router' — DNS-адрес роутера в туннеле (10.200.N.1), либо список серверов
WG_DNS=router
# Базовый порт: каждому пользователю выделяется WG_LISTEN_PORT + N
WG_LISTEN_PORT=51820
# Порт WireGuard на стороне клиента (поле Client Listen Port у пира)
WG_CLIENT_LISTEN_PORT=51820
# Префикс подсетей для пользователей (10.200.N.0/24)
WG_SUBNET_PREFIX=10.200
WG_PERSISTENT_KEEPALIVE=15

# --- Прочее ---
DB_PATH=bot.db
LOG_LEVEL=INFO
